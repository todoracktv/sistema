<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Sistema de Cotizaciones</title>
  </head>
  <body class="p-4">
    <slot />

    <div id="modal-input" class="modal hidden">
      <div class="modal-box">
        <h3 id="modal-title">Agregar producto</h3>

        <label>Cantidad</label>
        <input id="input-cantidad" type="number" min="1" value="1" />

        <label>Precio unitario (S/)</label>
        <input id="input-precio" type="number" min="0" step="0.01" />

        <div class="igv-box">
          <label>
            <input id="input-igv" type="checkbox" checked />
            Precio incluye IGV (18%)
          </label>
        </div>

        <div class="modal-actions">
          <button id="btn-cancelar" class="btn-danger" type="button">Cancelar</button>
          <button id="btn-agregar" class="btn-primary" type="button">Agregar</button>
        </div>
      </div>
    </div>

    <div id="modal-cliente" class="modal hidden">
      <div class="modal-box">
        <h3>Datos del cliente</h3>

        <label for="cliente-doc">DNI / RUC</label>
        <div class="doc-row">
          <input
            id="cliente-doc"
            type="text"
            inputmode="numeric"
            placeholder="Ej: 12345678 / 20123456789"
          />
          <button id="btn-consultar-doc" class="btn-primary" type="button">
            Buscar
          </button>
        </div>
        <p id="consulta-estado" class="consulta-estado"></p>

        <label for="cliente-nombre">Nombre / Razón social</label>
        <input
          id="cliente-nombre"
          type="text"
          placeholder="Se completa automáticamente con el RUC/DNI"
        />

        <label for="cliente-direccion">Dirección</label>
        <input
          id="cliente-direccion"
          type="text"
          placeholder="Ej: Av. Arequipa 123 - Lince"
        />

        <details class="avanzado">
          <summary>Opciones avanzadas (consulta de RUC/DNI)</summary>
          <label for="api-token">Token de API (opcional)</label>
          <input
            id="api-token"
            type="text"
            autocomplete="off"
            placeholder="Pega aquí tu token si tienes uno"
          />
          <small>
            La consulta se hace automáticamente desde el propio sistema. Solo
            necesitas un token si quieres más consultas o mayor velocidad. Si la
            consulta falla, puedes escribir la razón social y la dirección a mano.
          </small>
        </details>

        <div class="modal-actions">
          <button id="btn-cancelar-pdf" class="btn-danger" type="button">Cancelar</button>
          <button id="btn-generar-pdf" class="btn-primary" type="button">Generar PDF</button>
        </div>
      </div>
    </div>

    <script>
      import { initCotizacion } from "../scripts/cotizador.js";
      initCotizacion();
    </script>
  </body>
</html>

<style is:global>
  /* =========================
   VARIABLES CORPORATIVAS
========================= */
  :root {
    --primary: #1f7a5c;
    --primary-dark: #155c46;
    --accent: #e6f4ef;
    --bg: #f6f8fb;
    --card: #ffffff;
    --text: #1f2937;
    --muted: #6b7280;
    --border: #e5e7eb;
    --danger: #dc2626;
    --success: #16a34a;
    --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.06);
    --shadow-strong: 0 20px 60px rgba(0, 0, 0, 0.15);
  }

  /* =========================
   BASE
========================= */
  * {
    box-sizing: border-box;
  }

  body {
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      sans-serif;
    margin: 0;
    background: var(--bg);
    color: var(--text);
  }

  /* =========================
   HEADER
========================= */
  header {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    padding: 16px 24px;
    box-shadow: var(--shadow-soft);
  }

  header h1 {
    margin: 0;
    font-size: 20px;
    letter-spacing: 0.5px;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .numero-cotizacion {
    font-size: 13px;
    letter-spacing: 0.5px;
    background: rgba(255, 255, 255, 0.16);
    padding: 6px 12px;
    border-radius: 999px;
  }

  /* =========================
   CONTENEDORES
========================= */
  .container {
    max-width: 1400px;
    margin: auto;
    padding: 20px;
  }

  .seccion-titulo {
    font-size: 16px;
    font-weight: 700;
    color: var(--primary-dark);
    margin: 0 0 12px;
  }

  /* =========================
   BUSCADOR Y FILTROS
========================= */
  .toolbar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .toolbar input,
  .toolbar select {
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: white;
    font-size: 14px;
    font-family: inherit;
    transition: 0.2s;
  }

  .toolbar input {
    flex: 1;
    min-width: 220px;
  }

  .toolbar input:focus,
  .toolbar select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(31, 122, 92, 0.15);
  }

  .sin-resultados {
    color: var(--muted);
    font-size: 14px;
    margin-top: 18px;
  }

  /* =========================
   LISTA DE PRODUCTOS
========================= */
  #lista-productos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  /* =========================
   CARD PRODUCTO
========================= */
  .producto {
    background: var(--card);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    gap: 12px;
    align-items: center;
    cursor: pointer;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
    transition: all 0.25s ease;
  }

  .producto:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
    border-color: var(--primary);
  }

  .producto img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 10px;
    background: #f1f5f9;
    flex-shrink: 0;
  }

  .producto h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 700;
  }

  .producto p {
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.4;
  }

  .categoria-tag {
    display: inline-block;
    margin-top: 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--primary-dark);
    background: var(--accent);
    padding: 2px 9px;
    border-radius: 999px;
  }

  /* =========================
   COTIZACIÓN
========================= */
  #cotizacion {
    margin-top: 30px;
    background: var(--card);
    border-radius: 16px;
    padding: 18px;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border);
  }

  /* =========================
   TABLA
========================= */
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 12px;
    font-size: 13px;
  }

  th {
    background: var(--accent);
    color: var(--primary-dark);
    text-align: left;
    font-weight: 700;
    padding: 10px;
    border-bottom: 1px solid var(--border);
  }

  td {
    padding: 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  tr:hover {
    background: #f9fafb;
  }

  .carrito-img {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 8px;
    background: #f1f5f9;
  }

  .carrito-vacio {
    text-align: center !important;
    color: var(--muted);
    padding: 24px !important;
  }

  .btn-eliminar {
    background: transparent;
    color: var(--danger);
    font-size: 16px;
    padding: 4px 8px;
    line-height: 1;
  }

  .btn-eliminar:hover {
    background: rgba(220, 38, 38, 0.1);
  }

  /* =========================
   OPCIONES DE COTIZACIÓN
========================= */
  .opciones-cotizacion {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 18px;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .campo label {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }

  .campo input,
  .campo select,
  .campo textarea {
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: 14px;
    font-family: inherit;
    background: white;
    transition: 0.2s;
  }

  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(31, 122, 92, 0.15);
  }

  .campo-ancho {
    flex: 1;
    min-width: 240px;
  }

  .campo textarea {
    min-height: 72px;
    resize: vertical;
  }

  .descuento-grupo {
    display: flex;
    gap: 8px;
  }

  .descuento-grupo input {
    width: 120px;
  }

  /* =========================
   BOTONES
========================= */
  button {
    cursor: pointer;
    border: none;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    font-family: inherit;
    transition: all 0.2s ease;
  }

  button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-primary {
    background: var(--primary);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--primary-dark);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: #eef2f7;
    color: var(--text);
  }

  .btn-secondary:hover:not(:disabled) {
    background: #e2e8f0;
  }

  .btn-danger {
    background: var(--danger);
    color: white;
  }

  .btn-danger:hover:not(:disabled) {
    opacity: 0.9;
  }

  .btn-generar {
    margin-top: 18px;
    width: 100%;
    padding: 14px;
    font-size: 15px;
  }

  /* =========================
   TOTALES
========================= */
  .totales {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed var(--border);
    display: grid;
    gap: 6px;
    font-size: 15px;
  }

  .totales p {
    margin: 0;
  }

  .total-linea {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-dark);
  }

  /* =========================
   HISTORIAL
========================= */
  #historial {
    margin-top: 30px;
    background: var(--card);
    border-radius: 16px;
    padding: 18px;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border);
  }

  .historial-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .historial-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .historial-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fbfdfc;
  }

  .historial-numero {
    font-weight: 700;
    font-size: 14px;
  }

  .historial-cliente {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }

  .historial-total {
    font-weight: 700;
    color: var(--primary-dark);
    margin-top: 4px;
  }

  .historial-acciones {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .historial-acciones button {
    padding: 8px 12px;
    font-size: 12px;
  }

  /* =========================
   MODAL
========================= */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    backdrop-filter: blur(6px);
    padding: 16px;
  }

  .modal.hidden {
    display: none;
  }

  .modal-box {
    background: white;
    padding: 24px;
    border-radius: 18px;
    width: 100%;
    max-width: 440px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--shadow-strong);
    animation: modalIn 0.25s ease;
  }

  @keyframes modalIn {
    from {
      transform: translateY(30px) scale(0.96);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  .modal-box h3 {
    margin: 0 0 14px;
    font-size: 18px;
    font-weight: 700;
  }

  /* =========================
   INPUTS
========================= */
  .modal-box label {
    font-size: 12px;
    font-weight: 700;
    margin-top: 12px;
    display: block;
    color: var(--muted);
  }

  .modal-box input,
  .modal-box textarea {
    width: 100%;
    margin-top: 6px;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid var(--border);
    outline: none;
    font-size: 14px;
    font-family: inherit;
    transition: 0.2s;
  }

  .modal-box input:focus,
  .modal-box textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(31, 122, 92, 0.15);
  }

  /* =========================
   CONSULTA DE DOCUMENTO
========================= */
  .doc-row {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: 6px;
  }

  .doc-row input {
    margin-top: 0;
    flex: 1;
  }

  .doc-row button {
    white-space: nowrap;
    padding: 12px 16px;
  }

  .consulta-estado {
    font-size: 12px;
    margin: 8px 0 0;
    min-height: 16px;
    color: var(--muted);
    line-height: 1.4;
  }

  .consulta-estado.ok {
    color: var(--success);
  }

  .consulta-estado.error {
    color: var(--danger);
  }

  .consulta-estado.info {
    color: var(--primary);
  }

  .avanzado {
    margin-top: 16px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }

  .avanzado summary {
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    cursor: pointer;
  }

  .avanzado small {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 6px;
    line-height: 1.4;
  }

  /* =========================
   IGV BOX
========================= */
  .igv-box {
    margin-top: 12px;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }

  .igv-box label {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text);
  }

  .igv-box input {
    width: auto;
    margin-top: 0;
  }

  /* =========================
   MODAL ACTIONS
========================= */
  .modal-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .modal-actions button {
    flex: 1;
  }

  /* =========================
   RACK CUSTOM
========================= */
  .rack-custom {
    margin-top: 24px;
    padding: 16px;
    border-radius: 14px;
    background: linear-gradient(180deg, #ffffff, #f9fafb);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
  }

  .rack-custom h3 {
    margin: 0 0 10px;
    font-size: 15px;
    font-weight: 700;
    color: var(--primary-dark);
  }

  .rack-custom input,
  .rack-custom textarea {
    width: 100%;
    margin-bottom: 8px;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    font-size: 13px;
    font-family: inherit;
  }

  .rack-custom input[type="file"] {
    padding: 8px;
    background: white;
  }

  #btnAgregarCustom {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border: none;
    padding: 10px;
    border-radius: 10px;
    width: 100%;
    font-weight: 700;
    margin-top: 8px;
  }

  #btnAgregarCustom:hover {
    opacity: 0.95;
    transform: translateY(-1px);
  }

  /* =========================
   UTILIDADES
========================= */
  .hidden {
    display: none;
  }

  /* =========================
   RESPONSIVE
========================= */
  @media (max-width: 768px) {
    header {
      text-align: center;
    }

    .header-inner {
      justify-content: center;
    }

    .modal-box {
      margin: 0;
    }

    table {
      font-size: 12px;
    }

    .producto {
      padding: 12px;
    }

    .producto img {
      width: 52px;
      height: 52px;
    }

    .descuento-grupo input {
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    #lista-productos {
      grid-template-columns: 1fr;
    }

    .modal-actions {
      flex-direction: column;
    }

    .historial-item {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
